{
  "name": "snooptrade-monorepo",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "dev:frontend": "pnpm --filter snooptrade dev",
    "build:frontend": "pnpm --filter snooptrade build",
    "dev:mobile": "pnpm --filter snooptrade-mobile start",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter snooptrade test"
  }
}
